{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chouka",
  "compatibility_date": "2026-04-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build/client"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chouka",
      "database_id": ""
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": ""
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "chouka-images"
    }
  ],
  "vars": {
    "R2_DOMAIN": "https://cft1.cszxorx.dpdns.org",
    "GITHUB_OWNER": "lujih",
    "GITHUB_REPO": "chouka-images"
  }
}
